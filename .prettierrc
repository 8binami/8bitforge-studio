{
  "printWidth": 100,
  "tabWidth": 4,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "none",
  "arrowParens": "always",
  "overrides": [
    {
      "files": ["*.json", "*.yml", "*.yaml", "*.md", ".prettierrc"],
      "options": { "tabWidth": 2 }
    },
    {
      "files": ["src/i18n/locales/*.json"],
      "options": { "tabWidth": 4 }
    }
  ]
}
