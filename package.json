{
  "name": "8bitforge-studio",
  "version": "2.3.3",
  "description": "8BitForge Studio: open-source chiptune and 8-bit music studio. Runs offline, in the browser and on the desktop.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "author": "8Binami <contact@8binami.com>",
  "homepage": "https://8bitforge.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8binami/8bitforge-studio.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "apps/desktop/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:hosted": "vite build --mode hosted",
    "deploy:web": "node scripts/deploy-web.js",
    "preview": "vite preview",
    "dev:desktop": "node scripts/dev-desktop.js",
    "start:desktop": "npm run build && electron .",
    "build:desktop": "npm run build && electron-builder --config apps/desktop/electron-builder.yml",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,cjs,json,css,md,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "library:check": "node scripts/check-library.js",
    "postinstall": "node scripts/patch-electron-builder.js"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.8.1",
    "eslint": "^9.13.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.3.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tabler/icons-webfont": "^3.33.0",
    "bootstrap": "^5.3.8",
    "sortablejs": "^1.15.7"
  },
  "desktopName": "8bitforge.desktop"
}
